        ],
        "operationId": "listProjects",
        "summary": "List projects",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Records ordered by descending ID; empty collections return an empty array.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "projects"
                  ],
                  "properties": {
                    "projects": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Project"
                      }
                    }
                  }
                }
              }
            }
