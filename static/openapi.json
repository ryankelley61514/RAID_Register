{
  "openapi": "3.0.3",
  "info": {
    "title": "Project Ledger API",
    "version": "1.0.0",
    "description": "JSON API for projects, RAID records, and changelog entries. No authentication is required; all visitors can read, create, edit, and delete records. PATCH updates supplied fields only. Project deletion cascades to its children."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current application host"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Projects"
    },
    {
      "name": "RAID"
    },
    {
      "name": "Changelog"
    }
  ],
