  "components": {
    "schemas": {
      "Project": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "example": "Website launch"
          },
          "description": {
            "type": "string",
            "example": "Launch the new website."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC creation timestamp.",
            "example": "2026-09-25T12:00:00Z"
          }
        }
      },
      "RaidItem": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "kind",
          "title",
          "description",
          "owner",
          "status",
          "priority",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "project_id": {
            "type": "integer",
            "example": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "Risk",
              "Assumption",
              "Issue",
              "Dependency"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "example": "Vendor delivery delay"
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "Open",
              "In progress",
              "Closed"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC creation timestamp.",
            "example": "2026-09-25T12:00:00Z"
          }
        }
      },
      "ChangelogEntry": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "title",
          "body",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "project_id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "example": "Kickoff completed"
          },
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC creation timestamp.",
            "example": "2026-09-25T12:00:00Z"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "integer",
                "example": 404
              },
              "message": {
                "type": "string",
                "example": "The requested URL was not found on the server."
              }
            }
          }
        }
      },
      "ProjectDetail": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "created_at",
          "raid_items",
          "changelog_entries"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "example": "Website launch"
          },
          "description": {
            "type": "string",
            "example": "Launch the new website."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC creation timestamp.",
            "example": "2026-09-25T12:00:00Z"
          },
          "raid_items": {
            "type": "array",
            "description": "All associated records, newest ID first. Empty when no records exist.",
            "items": {
              "$ref": "#/components/schemas/RaidItem"
            }
          },
          "changelog_entries": {
            "type": "array",
            "description": "All associated records, newest ID first. Empty when no records exist.",
            "items": {
              "$ref": "#/components/schemas/ChangelogEntry"
            }
          }
        }
      },
      "ProjectCreate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
